---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { palette } from '../data/palette';
import { artistsFor, fold } from '../data/tracklists';

// Covers live in /covers, named after the playlist file
const covers = import.meta.glob<{ default: ImageMetadata }>('../../covers/*.jpg', { eager: true });

interface Props {
  playlist: CollectionEntry<'playlists'>;
}

const { playlist } = Astro.props;
const { title, genres, artists, color, smartlink, description } = playlist.data;
const swatch = palette[color];
// Everyone on the tape, from the tracklist export. The hand-picked names stay up front,
// the rest goes in the "more artists" list.
const fromTracklist = artistsFor(playlist.id);
const picked = artists.map(fold);
const isPicked = (name: string) => picked.some((p) => fold(name).includes(p) || p.includes(fold(name)));
const more = fromTracklist.filter((name) => !isPicked(name));
const everyone = [...artists, ...more];

const cover = covers[`../../covers/${playlist.id}.jpg`]?.default;

// Small, stable tilt per tape so the shelf looks hand-stacked
const hash = [...playlist.id].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7);
const tilt = ((Math.abs(hash) % 31) - 15) / 10; // -1.5deg .. 1.5deg
---

<article
  class="tape"
  data-color={color}
  data-text={fold(`${title} ${genres} ${swatch.use}`)}
  data-artists={JSON.stringify(everyone)}
  style={`--tilt:${tilt}deg; --band:${swatch.hex}; --band-ink:${swatch.ink === 'light' ? '#f4efe2' : '#1d1b18'}`}
>
  {cover ? (
    <Image class="cover" src={cover} alt="" width={520} height={520} />
  ) : (
    <div class="shell">
      <div class="label">
        <div class="band"><span>{genres}</span></div>
        <h3>{title}</h3>
        <div class="window" aria-hidden="true">
          <span class="reel"></span>
          <span class="tape-run"></span>
          <span class="reel"></span>
        </div>
      </div>
      <div class="screws" aria-hidden="true"><i></i><i></i></div>
    </div>
  )}

  <div class="card">
    {cover && <h3 class="title">{title}</h3>}
    <p class="hit" hidden></p>
    {description && <p class="desc">{description}</p>}
    {artists.length > 0 && (
      <p class="artists">{artists.join(' · ')}</p>
    )}
    {more.length > 0 && (
      <details class="more">
        <summary>+ {more.length} more {more.length === 1 ? 'artist' : 'artists'}</summary>
        <p>{more.join(' · ')}</p>
      </details>
    )}
    {smartlink && (
      <a
        class="listen"
        href={smartlink}
        rel="noopener"
        target="_blank"
        data-goatcounter-click={`listen/${playlist.id}`}
        data-goatcounter-title={`Listen: ${title}`}
      >Listen</a>
    )}
  </div>
</article>

<style>
  .tape {
    transform: rotate(var(--tilt));
    transition: transform 0.25s ease, opacity 0.25s ease, filter 0.25s ease;
  }
  .tape:hover,
  .tape:focus-within {
    transform: rotate(0deg) translateY(-3px);
  }

  .shell {
    position: relative;
    background: #24221f;
    border-radius: 10px;
    padding: 12px 12px 26px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 14px 26px -12px rgba(0, 0, 0, 0.85);
  }

  .label {
    background: var(--label);
    border-radius: 4px;
    padding: 0 12px 12px;
    background-image: var(--grain);
  }

  .band {
    margin: 0 -12px;
    padding: 5px 12px;
    background: var(--band);
    color: var(--band-ink);
    border-radius: 4px 4px 0 0;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  h3 {
    font-family: var(--marker);
    font-weight: 400;
    font-size: 1.35rem;
    line-height: 1.15;
    margin: 10px 0 10px;
    color: #1d1b18;
    min-height: 2.3em;
    display: flex;
    align-items: center;
  }

  .window {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: #2f2c28;
    border-radius: 999px;
    padding: 6px 14px;
    margin: 0 auto;
    max-width: 78%;
  }
  .reel {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background:
      radial-gradient(circle, #2f2c28 0 5px, transparent 6px),
      repeating-conic-gradient(#d9d1bd 0 20deg, #bdb39b 20deg 60deg);
    flex: none;
  }
  .tape-run {
    flex: 1;
    height: 16px;
    background: linear-gradient(#4a3a2a, #3a2c1f);
    border-radius: 3px;
  }

  .screws {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    display: flex;
    justify-content: space-between;
    padding: 0 16px;
  }
  .screws i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #46423c;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 16px 30px -14px rgba(0, 0, 0, 0.9);
  }
  .card .title {
    color: var(--text);
    min-height: 0;
    margin: 0 0 6px;
  }

  .card {
    padding: 12px 4px 0;
  }
  .desc {
    margin: 0 0 8px;
    font-size: 0.85rem;
  }
  .artists {
    margin: 0 0 10px;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .hit {
    display: inline-block;
    margin: 0 0 10px;
    padding: 3px 8px 2px;
    font-size: 0.75rem;
    background: var(--band);
    color: var(--band-ink);
    border-radius: 2px;
    transform: rotate(-1deg);
    box-shadow: 0 4px 10px -6px rgba(0, 0, 0, 0.9);
  }
  .hit[hidden] { display: none; }
  .hit :global(b) { font-weight: 600; }

  .more {
    margin: -4px 0 12px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .more summary {
    list-style: none;
    cursor: pointer;
    width: fit-content;
    color: var(--text);
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary:hover { text-decoration-style: solid; }
  .more p {
    margin: 6px 0 0;
    line-height: 1.6;
  }

  .listen {
    display: inline-block;
    font-size: 0.75rem;
    padding: 4px 10px 3px;
    border-radius: 2px;
    background: var(--label) var(--grain);
    color: var(--ink);
    text-decoration: none;
    transform: rotate(-1.5deg);
    box-shadow: 0 4px 10px -6px rgba(0, 0, 0, 0.9);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .listen:hover,
  .listen:focus-visible {
    background-color: var(--band);
    color: var(--band-ink);
    transform: rotate(0deg);
  }
</style>
